<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 进程起来那一下的窗口(Dart 还没画出第一帧)。父主题用 Black 而不是 Light:
         应用是深色主场,浅色设备上也该从黑起步,否则状态栏那一条会亮着。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- 系统画的启动画面,Flutter 画出第一帧后自动撤掉 -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- 进程已起来、Flutter 界面初始化期间,以及界面背后的窗口颜色。
         只有 Flutter Android embedding 的 V2 用得上它。 -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/nordic_bg</item>
    </style>
</resources>